            totalHT: Number(row.total_ht ?? 0),
            tva: Number(row.tva ?? 0),
            totalTTC: Number(row.total_ttc ?? 0)
        };
    }
    mapPurchase(row, itemMap) {
        return {
            id: row.id,
            code: row.code ?? "",
            supplierId: row.supplier_id ?? "",
            supplierName: row.supplier_name ?? "",
            purchaseDate: row.purchase_date,
