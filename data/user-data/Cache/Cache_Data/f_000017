    async fetchProducts(typeById) {
        const [{ data: productRows, error: productError }, { data: stockRows, error: stockError }] = await Promise.all([
            supabase.from("app_products").select("id, code, designation, product_type_id, price, reactive_start_date, reactive_end_date").order("designation", {
                ascending: true
            }),
            supabase.from("app_product_stock").select("product_id, depot, quantity")
        ]);
        if (productError) {
            throwIfTableMissing(productError, "app_products");
            throw productError;
        }
        if (stockError) {
            throwIfTableMissing(stockError, "app_product_stock");
            throw stockError;
        }
        const stockMap = new Map();
        (stockRows ?? []).forEach((row)=>{
            const entry = stockMap.get(row.product_id) ?? {
                A: 0,
                B: 0,
                C: 0
            };
            entry[row.depot] = Number(row.quantity ?? 0);
            stockMap.set(row.product_id, entry);
        });
        return (productRows ?? []).map((row)=>this.mapProduct(row, typeById, stockMap));
    }
